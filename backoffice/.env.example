# ─── Vercel KV ────────────────────────────────────────────────────────────────
# Vercel 대시보드 → Storage → Create KV 후 프로젝트에 연결하면 자동 주입됩니다
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ─── Resend ───────────────────────────────────────────────────────────────────
# https://resend.com 에서 API Key 발급
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Resend에서 도메인 인증 후 사용 (테스트 시 onboarding@resend.dev 사용 가능)
FROM_EMAIL=데일리 삼국지 <newsletter@yourdomain.com>

# ─── GitHub OAuth App ─────────────────────────────────────────────────────────
# https://github.com/settings/developers → New OAuth App
# Homepage URL: https://YOUR_VERCEL_URL
# Authorization callback URL: https://YOUR_VERCEL_URL/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 관리자로 허용할 GitHub 사용자명
ADMIN_GITHUB_USER=mimthedust

# ─── Session ──────────────────────────────────────────────────────────────────
# 강력한 랜덤 비밀키: openssl rand -hex 32
JWT_SECRET=

# ─── 서비스 URL ────────────────────────────────────────────────────────────────
# Vercel 배포 후 실제 URL로 업데이트
BACKOFFICE_URL=https://your-project.vercel.app
